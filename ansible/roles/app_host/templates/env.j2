# {{ ansible_managed }}
# The dev environment's configuration and secrets for docker compose (root only, mode 0600).
# The image tag lives in release.env, written by each deploy.

COMPOSE_PROJECT_NAME={{ app_compose_project }}
DATA_DIR={{ app_data_dir }}
ECR_REGISTRY={{ ecr_registry }}

# PostgreSQL (self-hosted in the stack). The generated password is letters and digits only, so the
# URL-encoded form is the same.
POSTGRES_USER={{ app_config.postgres_user }}
POSTGRES_USER_URLENCODED={{ app_config.postgres_user | urlencode }}
POSTGRES_PASSWORD={{ app_secrets.POSTGRES_PASSWORD }}
POSTGRES_PASSWORD_URLENCODED={{ app_secrets.POSTGRES_PASSWORD | urlencode }}

# Tokens and HMAC keys (each different, at least 32 characters).
JWT_SECRET={{ app_secrets.JWT_SECRET }}
SYSTEM_JWT_SECRET={{ app_secrets.SYSTEM_JWT_SECRET }}
INTERNAL_AUTH_SECRET={{ app_secrets.INTERNAL_AUTH_SECRET }}
NATIONAL_ID_HMAC_SECRET={{ app_secrets.NATIONAL_ID_HMAC_SECRET }}
EMAIL_CODE_HASH_SECRET={{ app_secrets.EMAIL_CODE_HASH_SECRET }}
OTP_HASH_SECRET={{ app_secrets.OTP_HASH_SECRET }}

# The gateway: the three web apps (and developer machines) may call it; Caddy is one proxy hop.
CORS_ORIGINS={{ (web_apps | map(attribute='host') | map('regex_replace', '^(.*)$', 'https://\\1.' ~ base_domain) | list + extra_app_origins) | join(',') }}
TRUSTED_PROXY_HOPS={{ app_config.trusted_proxy_hops }}

# S3 (credentials: the instance role; no keys here).
AWS_REGION={{ aws_region }}
AWS_S3_BUCKET={{ media_bucket }}
AWS_PUBLIC_BASE_URL={{ media_base_url }}
DRIVER_DOCUMENTS_BUCKET={{ documents_bucket }}

# Email (SES when the dev stack enables it) and SMS (off: no provider in dev).
EMAIL_PROVIDER={{ app_config.email_provider }}
SES_FROM_ADDRESS={{ ses_from_address }}
SMS_PROVIDER={{ app_config.sms_provider }}
PHONE_VERIFICATION_REQUIRED={{ app_config.phone_verification_required | string | lower }}

DEFAULT_DELIVERY_RADIUS_KM={{ app_config.default_delivery_radius_km }}
