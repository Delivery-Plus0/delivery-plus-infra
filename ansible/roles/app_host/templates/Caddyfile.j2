# {{ ansible_managed }}
#
# api.<domain>       -> the API gateway (TLS from Let's Encrypt)
# app./driver./restaurant.<domain> -> the static web builds of the three apps
# http://<static ip> -> the API gateway, for clients that use the bare IP
{
{% if acme_email %}
	email {{ acme_email }}
{% endif %}
	admin 127.0.0.1:2019
}

(common) {
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

api.{{ base_domain }} {
	import common
	# Server-sent events (live order tracking) are flushed as they arrive.
	reverse_proxy api-gateway:3000
}
{% for app in web_apps %}

{{ app.host }}.{{ base_domain }} {
	import common
	root * /srv/web/{{ app.name }}
	# Dynamic routes (/order/<id> -> order/[id].html), generated from the build by scripts/caddy-routes.py.
	import {{ caddy_routes_dir }}/{{ app.name }}.caddy
	try_files {path} {path}.html {path}/index.html /index.html
	header /_expo/static/* Cache-Control "public, max-age=31536000, immutable"
	file_server
}
{% endfor %}

http://{{ host_public_ip }} {
	reverse_proxy api-gateway:3000
}
