# Copy to terraform.tfvars (git-ignored) and fill in.
region       = "eu-central-1"
state_bucket = "delivery-plus-tfstate-123456789012"

# Your office/home public IP (curl -s https://checkip.amazonaws.com), as /32.
admin_cidrs = ["203.0.113.10/32"]

# ssh-keygen -t ed25519 -f ~/.ssh/delivery-plus-deploy -C delivery-plus-deploy
ssh_public_key = "ssh-ed25519 AAAA... delivery-plus-deploy"

jenkins_instance_type = "t3.medium"
